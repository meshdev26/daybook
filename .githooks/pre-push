#!/usr/bin/env bash
# Fast local guard for AGENT.md's verify-before-push rule; not a CI suite.
set -u

die() { printf 'pre-push: %s\n' "$1" >&2; exit 1; }

# A dirty tracked tree means the pushed state was never reviewed.
if ! git diff --quiet -- || ! git diff --cached --quiet --; then
  die 'uncommitted tracked changes; commit or stash before pushing'
fi

head=$(git rev-parse HEAD) || die 'cannot resolve HEAD'

# Prefer upstream, then origin/master; otherwise inspect the last commit only.
if upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) && [ -n "$upstream" ]; then
  base=$(git rev-parse "$upstream") || die 'cannot resolve upstream'
  log_spec="$base..$head"
elif base=$(git rev-parse --verify --quiet origin/master 2>/dev/null) && [ -n "$base" ]; then
  log_spec="$base..$head"
elif git rev-parse --verify --quiet HEAD~1 >/dev/null 2>&1; then
  base=$(git rev-parse HEAD~1)
  log_spec="$base..$head"
else
  base=$(git hash-object -t tree /dev/null) # root commit: diff against empty tree
  log_spec='-1'                             # log only the root commit
fi

# Whitespace errors in the lines being pushed.
git diff --check "$base" "$head" -- . ':(exclude).githooks/pre-push' || die 'whitespace errors in pushed changes'

# Drafts and announcements must never leave the machine.
if git diff --name-only "$base" "$head" -- | grep -iE '(draft|announcement)' >/dev/null 2>&1 ||
   git diff --cached --name-only -- | grep -iE '(draft|announcement)' >/dev/null 2>&1; then
  die 'DRAFT/ANNOUNCEMENT file in pushed range'
fi

# Banned tokens in commit messages and added lines. The hook source is excluded:
# it necessarily contains the patterns it enforces.
banned='§|WCAG [0-9]|Attack: |Owning rung|security LOW finding|\([0-9],[0-9],[0-9]\)'
if git log $log_spec --format='%B' | grep -E "$banned" >/dev/null 2>&1; then
  die 'banned pattern in commit message'
fi
added=$(git diff "$base" "$head" -- . ':(exclude).githooks/pre-push' | grep -E '^[+]' | grep -v '^[+][+][+]' || true)
if [ -n "$added" ]; then
  if printf '%s\n' "$added" | grep -E "$banned" >/dev/null 2>&1; then
    die 'banned comment pattern in added lines'
  fi
  if grep -Pq '[\x{1F000}-\x{1FAFF}\x{2600}-\x{27BF}]|^\+\s*([=~#*_\-])\1{7,}\s*$' <<<"$added"; then
    die 'emoji/banner line in added lines'
  fi
fi

exit 0
