# Note: variables already set in the real environment win over this file
# (standard dotenv behavior). Systemd/desktop launches have a clean env,
# so this file is authoritative there.
# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Your Telegram user id (owner). Get it via @userinfobot (required)
OWNER_ID=

# SQLite database path
DATABASE_URL=sqlite:./data/agent.db

# Logging
RUST_LOG=info

# Optional: target channel default (can also set via web setup)
DEFAULT_CHANNEL=

# Optional: Crypto Pay API token from @CryptoBot -> Crypto Pay -> Create App
CRYPTO_PAY_TOKEN=

# Web dashboard
WEB_PORT=8080
# Bind address. 127.0.0.1 (default) keeps the dashboard local — right for
# desktop use. Servers/Docker should set 0.0.0.0 behind a TLS proxy.
WEB_BIND=127.0.0.1
# Open the dashboard in the system browser at startup
# (default: auto on Windows/macOS, off on Linux)
#OPEN_BROWSER=1
WEB_USERNAME=owner
WEB_PASSWORD=

# Optional: sub-path the dashboard is served under behind a reverse proxy
# (must start with "/", empty = root)
#WEB_BASE_PATH=

# Optional: public dashboard URL used in links (default: derived from
# WEB_PORT and WEB_BASE_PATH)
#WEB_URL=

# Optional: custom data directory (default: ./data in portable mode, else the
# platform dir — see docs/DESKTOP.md)
#DATABASE_DIR=

# MFA recovery codes (default on); 0/false/no/off rejects stored codes and hides the recovery UI.
#MFA_RECOVERY_CODES_ENABLED=1

# Webhook mode is not implemented; the bot always uses long polling.

# Optional: AI assistant features (off unless AI_ENABLED is set)
#AI_ENABLED=               # set to 1/true to enable
#AI_PROVIDER=              # openai (default) or anthropic
#AI_API_STYLE=             # API wire style: openai or anthropic (default: follows AI_PROVIDER)
#AI_BASE_URL=              # API root (default: https://api.openai.com/v1)
#AI_API_KEY=               # key for the chosen provider
#AI_MODEL=                 # model name (default: gpt-4o-mini)
#AI_DAILY_TOKEN_BUDGET=    # optional daily token cap (integer)

# Optional: MCP server for AI agents (Model Context Protocol).
# Empty/unset = endpoint disabled entirely (secure default OFF).
# The token maps to the OWNER principal: read tools + publishing run
# directly; sensitive tools (gen_codes, delete_post, broadcast) always
# require your approval via /approve <id> in the bot.
MCP_OWNER_TOKEN=
